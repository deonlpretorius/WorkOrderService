Accept: application/json

### Work Orders
### Get All Work Orders
GET {{DigitalTwin_WebAPI_HostAddress}}/api/workorders/GetAllWorkOrders
Accept: application/json

### Get Work Order by ID
GET {{DigitalTwin_WebAPI_HostAddress}}/api/workorders/GetWorkOrderById/"1"
Accept: application/json

### Get Work Order By Work Order Status
GET {{DigitalTwin_WebAPI_HostAddress}}/api/workorders/GetWorkOrderByStatus
Accept: application/json

### Create a work order.
POST {{DigitalTwin_WebAPI_HostAddress}}/api/workorders/CreateWorkOrder
Accept: application/json

### Update an Work Order
PUT {{DigitalTwin_WebAPI_HostAddress}}/api/workorders/UpdateWorkOrder
Accept: application/json

### Delete a Work Order
DELETE {{DigitalTwin_WebAPI_HostAddress}}/api/workorders/DeleteWorkOrder/"2"
Accept: application/json

